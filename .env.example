# Copy this file to `.env.local` and fill in what you have.

# Unpaywall needs a REAL, contactable email for its polite pool.
# Without it, the "Find free PDF" button is disabled (everything else works).
UNPAYWALL_EMAIL=your-real-email@gmail.com

# Optional — Semantic Scholar API key. Without it, S2 still works but is
# rate-limited (it may occasionally return errors; the app falls back to the
# other sources automatically).
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional — CORE API key. Without it, CORE results are skipped (everything
# else still works). 30-day free trial, then license required.
# Get one at: https://core.ac.uk/api-keys/register
CORE_API_KEY=

# Optional — BASE API key. Without it, BASE results are skipped (everything
# else still works). Free for non-commercial use.
# Apply at: https://www.base-search.net/about/en/contact.php
BASE_API_KEY=

# Recommended - a real contact email sent to OpenAlex, Crossref, PubMed, Zenodo and
# other free APIs (their "polite pool": faster, more reliable rate limits).
# Falls back to UNPAYWALL_EMAIL, then to a placeholder.
CONTACT_EMAIL=your-real-email@gmail.com

# Recommended - free OpenAlex API key. OpenAlex pauses anonymous searches
# whenever it is under load, which makes OpenAlex fail; a key is exempt.
# Get one at: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Local testing only. Points the app at the Firebase emulators
# (Auth 9099, Firestore 8085). Never set this in Vercel.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
