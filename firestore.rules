rules_version = '2';

// Thesisweb Firestore rules.
// Publish: Firebase console → Firestore Database → Rules → paste → Publish.
//
// Layout:
//   users/{uid}/profile/main     display name                   (owner only)
//   users/{uid}/papers/{paperId} saved papers                   (owner only)
//   shared/{shareId}             a group library shared by link (public get, owner write)
//
// Passwords are reset by Firebase's email link, so nothing about an account is
// readable by anyone else.
//
// Anything not matched here is denied. Size checks stop one account from
// filling the free-tier quota with junk.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Field is absent, null, or a string no longer than max.
    function optString(d, key, max) {
      return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max);
    }

    // ── Profile ──────────────────────────────────────────────────────────
    match /users/{uid}/profile/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && docId == 'main'
        && request.resource.data.keys().hasOnly(['username', 'createdAt', 'prefs'])
        && optString(request.resource.data, 'username', 60)
        && (!('prefs' in request.resource.data) || request.resource.data.prefs is map)
        && (!('prefs' in request.resource.data) || request.resource.data.prefs.keys().size() <= 20);
    }

    // ── Saved papers ─────────────────────────────────────────────────────
    match /users/{uid}/papers/{paperId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 1000
        && optString(request.resource.data, 'abstract', 40000)
        && optString(request.resource.data, 'tldr', 2000)
        && optString(request.resource.data, 'notes', 20000)
        && optString(request.resource.data, 'collection', 100)
        && (!('matrix' in request.resource.data) || request.resource.data.matrix is map);
    }

    // ── Shared group libraries ───────────────────────────────────────────
    // A copy of some papers, readable by anyone who has the link (the id is
    // random). Only the owner can list, change or remove their shares.
    match /shared/{shareId} {
      function validShare() {
        let d = request.resource.data;
        return d.keys().hasOnly(['owner', 'ownerName', 'name', 'papers', 'createdAt', 'updatedAt'])
          && d.owner == request.auth.uid
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.ownerName is string && d.ownerName.size() <= 60
          && d.papers is list && d.papers.size() <= 200
          && d.createdAt is number && d.updatedAt is number;
      }

      allow get: if true;
      allow list: if signedIn() && resource.data.owner == request.auth.uid;
      allow create: if signedIn() && validShare();
      allow update: if signedIn() && resource.data.owner == request.auth.uid && validShare();
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }
  }
}
