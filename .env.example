# Copy this file to `.env.local` and fill in what you have.

# Required — Firebase config, from Firebase console > Project settings > Your
# apps > Web app > SDK setup and configuration > Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics. From the same page, or
# Project settings > Integrations > Google Analytics. Without it, Analytics
# is skipped; sign-in and the library still work.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Unpaywall needs a REAL, contactable email for its polite pool.
# Without it, the "Find free PDF" button is disabled (everything else works).
UNPAYWALL_EMAIL=your-real-email@gmail.com

# Optional — Semantic Scholar API key. Without it, S2 still works but is
# rate-limited (it may occasionally return errors; the app falls back to the
# other sources automatically).
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Optional - free Google Books API key. Adds textbooks and monographs across
# every field. The API works without a key at a low anonymous quota; a key
# avoids shared-quota errors during busy periods.
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Recommended - a real contact email sent to OpenAlex, Crossref, PubMed, Zenodo and
# other free APIs (their "polite pool": faster, more reliable rate limits).
# Falls back to UNPAYWALL_EMAIL, then to a placeholder.
CONTACT_EMAIL=your-real-email@gmail.com

# Recommended - free OpenAlex API key. OpenAlex pauses anonymous searches
# whenever it is under load, which makes OpenAlex fail; a key is exempt.
# Get one at: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional - free NCBI API key: PubMed and PubMed Central allow 10 requests/s
# instead of 3. Without it they still work, just paced more slowly.
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional - free Springer Nature Basic API key. Adds 16M+ journal articles,
# book chapters and protocols. The free plan allows 500 hits/day and 100/min;
# without a key the source is inactive.
# Get one at: https://dev.springernature.com/
SPRINGER_NATURE_API_KEY=

# Optional - free NASA ADS personal API token. Adds astronomy, physics and
# earth/space science literature. Default allowance is 5,000 requests/day;
# without a token the source is inactive.
# Get one at: https://ui.adsabs.harvard.edu/user/settings/token
NASA_ADS_TOKEN=

# Optional - free CourtListener API token. Adds U.S. case law and RECAP
# dockets. Default limits are 5 requests/minute, 50/hour and 125/day; without
# a token the source is inactive. Create a free account, then copy the token
# from your profile: https://www.courtlistener.com/profile/api-token/
COURTLISTENER_API_TOKEN=

# Optional - free Europeana API key. Create a free account, then request a
# personal key at: https://www.europeana.eu/account/api-keys
EUROPEANA_API_KEY=

# Optional - free DPLA API key. Request one by POSTing your email address:
#   curl.exe -X POST "https://api.dp.la/v2/api_key/you@example.com"
# The 32-character key is emailed to you. With PowerShell:
#   Invoke-RestMethod -Method Post -Uri "https://api.dp.la/v2/api_key/you@example.com"
DPLA_API_KEY=

# Optional - free CORE API key. CORE works without one, but its anonymous
# rate limit is low, so busy periods show CORE as failed. A revoked or expired
# key gets 401 and CORE fails every search until it is replaced.
# Get one at: https://core.ac.uk/services/api
CORE_API_KEY=

# Optional - free CiNii Research Application ID (appid), from Japan's National
# Institute of Informatics. Raises the rate limit; the endpoint also answers
# anonymously, and the adapter falls back to that if a new appid is refused.
# Adds Japanese and Asian articles, theses and books.
# Get one at: https://support.nii.ac.jp/en/cir/r_opensearch
CINII_APP_ID=

# Optional - free IEEE Xplore Metadata Search key. Adds IEEE journals,
# conference papers and standards (engineering and computing). The free key
# allows 200 calls a day, so responses are cached for 24 hours and the source
# stops once the daily budget is spent. A 403 "Developer Inactive" reply means
# the key is not active yet; IEEE activates new keys during weekday business
# hours (US Eastern). You can paste several keys separated by commas: the
# adapter tries them in order and uses the first one IEEE has activated.
# Get one at: https://developer.ieee.org/apps/register
IEEE_XPLORE_API_KEY=

# Optional - free Upstash Redis (upstash.com, or Vercel > Storage > Upstash, which
# sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both names work). Makes the
# API rate limits count across every server instance, not per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local testing only. Points the app at the Firebase emulators
# (Auth 9099, Firestore 8085). Never set this in Vercel.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Shown on the Privacy Policy and Terms pages as the contact for privacy and
# account-deletion requests. Public — it is rendered in the page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional - the public address for canonical links, the sitemap and share
# cards. Defaults to https://thesiswebph.vercel.app; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional - Google Search Console HTML-tag verification code (only the
# content="..." value). See "Search engines" in the README.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional - Firebase App Check. Off unless NEXT_PUBLIC_APP_CHECK_ENABLED=1.
# Only turn it on together with enforcement (Firebase Console > App Check >
# APIs): without enforcement it blocks nothing, and it still costs ~350 KB of
# reCAPTCHA on every page. Verify the key first, watch the console for valid
# tokens for a day, then set this flag and enforce. reCAPTCHA v3 is free;
# Enterprise needs a Google Cloud billing account. The v3 key wins when both
# are set.
NEXT_PUBLIC_APP_CHECK_ENABLED=
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional - error reporting (Sentry). Off unless these are set, so local runs
# and previews without a project stay silent. The DSN is not a secret, but only
# the NEXT_PUBLIC_ copy reaches the browser. The SDK is imported on demand, so
# without a DSN it costs no download. To turn it on: create a Next.js project
# at sentry.io, copy its DSN into both variables, redeploy, then trigger one
# error to confirm it arrives.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
