# Copy this file to `.env.local` and fill in what you have.

# Required — Firebase config, from Firebase console > Project settings > Your
# apps > Web app > SDK setup and configuration > Config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — enables Firebase Analytics. From the same page, or
# Project settings > Integrations > Google Analytics. Without it, Analytics
# is skipped; sign-in and the library still work.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Unpaywall needs a REAL, contactable email for its polite pool.
# Without it, the "Find free PDF" button is disabled (everything else works).
UNPAYWALL_EMAIL=your-real-email@gmail.com

# Optional — Semantic Scholar API key. Without it, S2 still works but is
# rate-limited (it may occasionally return errors; the app falls back to the
# other sources automatically).
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Recommended - a real contact email sent to OpenAlex, Crossref, PubMed, Zenodo and
# other free APIs (their "polite pool": faster, more reliable rate limits).
# Falls back to UNPAYWALL_EMAIL, then to a placeholder.
CONTACT_EMAIL=your-real-email@gmail.com

# Recommended - free OpenAlex API key. OpenAlex pauses anonymous searches
# whenever it is under load, which makes OpenAlex fail; a key is exempt.
# Get one at: https://openalex.org/settings/api
OPENALEX_API_KEY=

# Optional - free NCBI API key: PubMed and PubMed Central allow 10 requests/s
# instead of 3. Without it they still work, just paced more slowly.
# Get one at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Optional - free CORE API key. CORE works without one, but its anonymous
# rate limit is low, so busy periods show CORE as failed. A revoked or expired
# key gets 401 and CORE fails every search until it is replaced.
# Get one at: https://core.ac.uk/services/api
CORE_API_KEY=

# Optional - free IEEE Xplore Metadata Search key. Adds IEEE journals,
# conference papers and standards (engineering and computing). The free key
# allows 200 calls a day, so responses are cached for 24 hours and the source
# stops once the daily budget is spent.
# Get one at: https://developer.ieee.org/apps/register
IEEE_XPLORE_API_KEY=

# Optional - free Upstash Redis (upstash.com, or Vercel > Storage > Upstash, which
# sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both names work). Makes the
# API rate limits count across every server instance, not per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local testing only. Points the app at the Firebase emulators
# (Auth 9099, Firestore 8085). Never set this in Vercel.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1

# Shown on the Privacy Policy and Terms pages as the contact for privacy and
# account-deletion requests. Public — it is rendered in the page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional - the public address for canonical links, the sitemap and share
# cards. Defaults to https://thesiswebph.vercel.app; set it for a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional - Google Search Console HTML-tag verification code (only the
# content="..." value). See "Search engines" in the README.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
